PORT=8787
HOST=127.0.0.1
TZ=America/Sao_Paulo
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_FALLBACK_MODEL=
# Only for a direct Ollama cloud connection:
