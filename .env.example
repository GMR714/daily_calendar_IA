ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
TELEGRAM_BOT_TOKEN=
# Your personal chat ID, required before the bot can read or change your agenda:
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_POLLING=true
# Cockpit da IA (tela /cockpit): o app roda o `cli.py cockpit --json` do Copiloto
COCKPIT_CLI=C:\Dev\Dev Seazone\copiloto\cli.py
COCKPIT_PYTHON=py
